# Copy to .env and fill in. Never commit .env.

# --- LLM (script synthesis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Text-to-speech ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- X / Twitter live summaries ---
XAI_API_KEY=
GROK_MODEL=grok-4

# --- Gmail (OAuth) ---
# Path to OAuth client secret JSON downloaded from Google Cloud Console.
# Path to cached user token (created on first run).
GMAIL_CLIENT_SECRET_PATH=./credentials/client_secret.json
GMAIL_TOKEN_PATH=./credentials/token.json
GMAIL_LABEL=briefing

# --- Storage / hosting (pick one) ---
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=briefcast
R2_PUBLIC_BASE_URL=

# Or AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=briefcast

# --- Briefing config ---
BRIEFING_TARGET_MINUTES=15
BRIEFING_TIMEZONE=Europe/Copenhagen
